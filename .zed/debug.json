[
  {
    "label": "Django development server",
    "adapter": "Debugpy",
    "request": "launch",
    "program": "./src/backend/manage.py",
    "python": "./venv/bin/python",
    "cwd": "./src/backend",
    "args": [
      "runserver",
      "127.0.0.1:8000",
      "--insecure",
      "--noreload"
    ],
    "env": {
      "DJANGO_SETTINGS_MODULE": "config.settings"
    }
  },
  {
    "label": "Debug vacation entitlement test",
    "adapter": "Debugpy",
