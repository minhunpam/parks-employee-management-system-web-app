      "test",
      "employees.tests.test_vacation_entitlement.VacationEntitlementTests.test_new_year_and_month_use_employee_entitlement"
    ],
    "justMyCode": true
  },
  {
    "label": "Employee creation and subsequent modifications test",
    "adapter": "Debugpy",
